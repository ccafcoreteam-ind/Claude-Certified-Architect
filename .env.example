# Copy to .env (or just export these) to run the model-calling demos LIVE.
# Without a key, every demo still runs in clearly-labelled SIMULATED mode.

# Your Claude API key. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model used for live calls (defaults to a current Claude model).
# CCARCH_MODEL=claude-sonnet-4-6
